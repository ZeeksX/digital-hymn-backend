# ==========================================
# Digital Hymn Book — Environment Variables
# ==========================================

# Application Environment
NODE_ENV=development
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/digital-hymn-book

# Permitted Frontend Origins (Comma-separated for multiple origins)
# For Angular development, default is http://localhost:4200
FRONTEND_ORIGIN=http://localhost:4200,http://127.0.0.1:4200

# Security Secrets (Generate random 32+ character strings for production)
COOKIE_SECRET=replace_with_a_secure_cookie_secret_at_least_32_characters_long
JWT_ACCESS_SECRET=replace_with_a_secure_jwt_access_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=replace_with_a_secure_jwt_refresh_secret_at_least_32_characters_long

# Google Identity / OAuth 2.0 Client ID
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
